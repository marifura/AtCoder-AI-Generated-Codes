            "auto len = make_vec({H, W}, MAX);",
            "using State = tuple<ll, ll, ll>; // 距離, h, w",
            "priority_queue<State, vector<State>, greater<State>> que;",
            "",
            "// 初期状態を作成",
            "ll start_h = ${1:0};",
            "ll start_w = ${2:0};",
            "que.push({0, start_h, start_w});",
            "len[start_h][start_w] = 0;",
            "",
            "while (!que.empty()) {",
            "    auto [current_len, h, w] = que.top();",
            "    que.pop();",
            "",
            "    if (len[h][w] != current_len) continue;",
            "",
            "    rep(m, 4) {",
            "        ll hh = h + dh[m];",
            "        ll ww = w + dw[m];",
            "",
            "        if (!isvalid(hh, ww)) continue;",
            "        if (S[hh][ww] == '#') continue;",
            "",
            "        ll next_len = current_len + ${3:1};",
            "        if (len[hh][ww] <= next_len) continue;",
            "",
            "        len[hh][ww] = next_len;",
            "        que.push({next_len, hh, ww});",
            "    }",
            "}",
            "",
            "$0"
